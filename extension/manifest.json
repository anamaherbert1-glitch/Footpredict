{
  "manifest_version": 3,
  "name": "FootPredict",
  "version": "1.1.0",
  "description": "Analyse probabiliste de matchs de football avec moteur FootPredict.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.melbet.com/*",
    "*://*.1xbet.com/*",
    "*://*.1xbet.fr/*",
    "*://*.1xbet.bet/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.melbet.com/*",
        "*://*.1xbet.com/*",
        "*://*.1xbet.fr/*",
        "*://*.1xbet.bet/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "action": {
    "default_title": "Ouvrir FootPredict"
  }
}